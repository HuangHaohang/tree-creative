:80 {
    encode zstd gzip

    @health path /healthz
    respond @health 200

    handle /api/* {
        reverse_proxy api:8000
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    root * /srv
    try_files {path} /index.html
    file_server
}
