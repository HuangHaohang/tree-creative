# Copy this file to .env for local UAT. Never commit real secrets.

COMPOSE_PROJECT_NAME=tree-creative-uat
APP_ENV=uat
APP_NAME=tree-creative
LOG_LEVEL=INFO
DEBUG=false
DOCS_ENABLED=true
FRONTEND_PORT=8080
API_PORT=8000

# Use long, randomly generated values outside local development.
MYSQL_ROOT_PASSWORD=replace-with-a-random-root-password
MYSQL_DATABASE=tree_creative
MYSQL_USER=tree_creative
MYSQL_PASSWORD=replace-with-a-random-app-password
MYSQL_URL=mysql+asyncmy://tree_creative:replace-with-a-random-app-password@mysql:3306/tree_creative

REDIS_PASSWORD=replace-with-a-random-redis-password
REDIS_URL=redis://:replace-with-a-random-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:replace-with-a-random-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-a-random-redis-password@redis:6379/2
LANGGRAPH_REDIS_URL=redis://:replace-with-a-random-redis-password@redis:6379/3

MINIO_ROOT_USER=tree-creative
MINIO_ROOT_PASSWORD=replace-with-a-random-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=tree-creative
MINIO_SECRET_KEY=replace-with-a-random-minio-password
MINIO_SECURE=false
MINIO_BUCKET=tree-creative
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

SESSION_SECRET=replace-with-at-least-32-random-characters
FRONTEND_BASE_URL=http://localhost:8080
WPS_GATEWAY_BASE_URL=https://wps-sso.shueho.com
WPS_GATEWAY_CLIENT_SERVICE=tree-creative
WPS_GATEWAY_CLIENT_SECRET=replace-with-server-side-secret
WPS_GATEWAY_REDIRECT_URI=http://localhost:8000/api/oauth/callback
AUTH_SESSION_COOKIE_NAME=tree_creative_session
AUTH_SESSION_TTL_SECONDS=28800
AUTH_LOGIN_STATE_TTL_SECONDS=600
AUTH_TOKEN_VERIFY_INTERVAL_SECONDS=300
AUTH_TOKEN_REFRESH_LEEWAY_SECONDS=120
ALLOWED_ORIGINS=["http://localhost:8080"]
ALLOWED_HOSTS=["localhost","127.0.0.1","api","testserver"]
